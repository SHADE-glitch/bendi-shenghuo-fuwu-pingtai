# ============================================================
# Local Life Service Platform — Environment Configuration
# Copy this file to `.env` before starting:  cp .env.example .env
# Default values work out of the box for Docker Compose.
# Only change secrets (marked below) for anything serious.
# ============================================================

# ---- Common ----
TZ=Asia/Shanghai

# ---- Backend (Spring Boot) ----
SERVER_PORT=8081
HMDP_UPLOAD_DIR=uploads/icon

# ---- MySQL ----
# Host port mapped by Docker Compose (loopback only).
MYSQL_PORT=3306
# [SECRET] Root password used by the MySQL container.
# Must stay identical to SPRING_DATASOURCE_PASSWORD below.
# Accepted Risk: the application currently connects as `root` because Flyway
# migrations run on the same connection and need DDL rights. Proper fix is a
# separate least-privilege app account + a dedicated migration profile.
MYSQL_ROOT_PASSWORD=change-me
# Database created on first boot.
MYSQL_DATABASE=hmdp
# Docker Compose: use service name `mysql` + internal port 3306.
# Local run: replace with 127.0.0.1:<MYSQL_PORT>.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/hmdp?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=utf8
SPRING_DATASOURCE_USERNAME=root
# [SECRET] Must match MYSQL_ROOT_PASSWORD above.
SPRING_DATASOURCE_PASSWORD=change-me

# ---- Redis ----
# Host port mapped by Docker Compose (loopback only).
REDIS_PORT=6379
# Docker Compose: use service name `redis`. Local run: use 127.0.0.1.
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
# [SECRET] Server-side `requirepass`. Redis holds login sessions
# (`login:token:*`) and seckill stock, so it must never run unauthenticated.
REDIS_PASSWORD=change-me
# [SECRET] Client-side password. Must match REDIS_PASSWORD above.
# `application.yml` intentionally has NO default for this: if it is missing the
# application fails to start instead of silently degrading to an open Redis.
SPRING_REDIS_PASSWORD=change-me

# ---- Frontend (Vite dev server) ----
# Host port mapped by Docker Compose.
VITE_DEV_PORT=5173
# Docker Compose: http://backend:8081. Local run: http://127.0.0.1:<SERVER_PORT>.
VITE_PROXY_TARGET=http://backend:8081
# [SECRET] AMap Web JS API key — apply at https://lbs.amap.com/ (fake value here).
VITE_AMAP_KEY=00000000000000000000000000000000
# [SECRET] AMap security code (安全密钥) paired with the key above (fake value here).
VITE_AMAP_SECURITY_CODE=00000000000000000000000000000000
